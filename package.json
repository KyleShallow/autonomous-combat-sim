{
  "name": "autonomous-combat-sim",
  "version": "0.1.0",
  "description": "Melee-first autonomous combat simulation — discrete ticks, D6 skill resolution, anatomy/armor/impact pipeline",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "duel": "tsx src/cli/duel.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "combat-simulation",
    "melee",
    "d6",
    "tactics"
  ],
  "author": "KyleShallow",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
